# Base path for the Vite build (Req 10.2).
#
# Set this to the GitHub Pages project subpath when deploying to
# https://<user>.github.io/<repo>/ — for example:
#
#   VITE_BASE_PATH=/pdf-presentation-canvas/
#
# Leave unset (or "/") for local development and for a root-domain deployment.
VITE_BASE_PATH=/
